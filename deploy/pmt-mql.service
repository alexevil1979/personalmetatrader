[Unit]
Description=PersonalMetaTrader MQL execution service (sandboxed)
After=network.target

[Service]
User=pmtmql
Group=pmtmql
EnvironmentFile=/etc/pmt-mql.env
WorkingDirectory=/opt/pmt-mql
ExecStart=/usr/bin/node /opt/pmt-mql/service.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=1500M
TasksMax=200

[Install]
WantedBy=multi-user.target
